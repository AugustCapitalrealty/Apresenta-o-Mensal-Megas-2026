/** SLIDE 04 — Composição da receita. Gráficos 2D com percentuais diretos. */
function gerarSlideComposicaoReceitaDemercado(){const d=obterComposicaoReceitaDemercado_(),c=_dmNovoSlide_('Composição da Receita — Demercado','Participação por cliente e por empreendimento');_dmBarrasParticipacao_(c.slide,c.W,c.H,c.W*.06,c.H*.24,c.W*.40,'POR CLIENTE',_dmConsolidar_(d.porCliente));_dmBarrasParticipacao_(c.slide,c.W,c.H,c.W*.54,c.H*.24,c.W*.40,'POR EMPREENDIMENTO',_dmConsolidar_(d.porEmpreendimento));}
function _dmConsolidar_(xs){const a=xs.map(x=>({nome:x.nome,participacao:x.participacao,n:_dmNumero_(x.participacao)})).sort((x,y)=>y.n-x.n),max=8;if(a.length<=max)return a;const keep=a.slice(0,max-1),rest=a.slice(max-1),n=rest.reduce((s,x)=>s+x.n,0);keep.push({nome:'Outros ('+rest.length+')',participacao:n.toFixed(1).replace('.',',')+'%',n:n});return keep;}
function _dmBarrasParticipacao_(s,W,H,x,y,w,titulo,xs){const DS=CR_DESIGN_SYSTEM;_rrUmaLinha_(s,x,y,w,H*.055,titulo,{fs:W*.015,bold:true,cor:DS.colors.brandMed,align:'L',folga:0});const max=Math.max.apply(null,xs.map(a=>Math.abs(a.n)).concat([1])),rh=H*.065;xs.forEach((a,i)=>{const yy=y+H*.07+i*rh;_rrUmaLinha_(s,x,yy,w*.34,rh,a.nome,{fs:W*.0095,cor:DS.colors.textMain,align:'L'});const bw=w*.48*Math.abs(a.n)/max,bar=s.insertShape(SlidesApp.ShapeType.RECTANGLE,x+w*.35,yy+rh*.22,bw,rh*.55);bar.getFill().setSolidFill(i%2?DS.colors.brandLight:DS.colors.brandMed);bar.getBorder().setTransparent();_rrUmaLinha_(s,x+w*.84,yy,w*.16,rh,a.participacao,{fs:W*.0105,bold:true,cor:DS.colors.textMain});});}
