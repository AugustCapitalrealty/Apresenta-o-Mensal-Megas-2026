/** SLIDE 07 — Cronograma de contratos: mesma base para ABL e receita. */
function gerarSlideContratosDemercado(){const d=obterContratosDemercado_(),c=_dmNovoSlide_('Cronograma dos Contratos — Demercado','Vencimentos por ABL e por receita (inclui prazo indeterminado)');_dmCronograma_(c.slide,c.W,c.H,c.W*.055,c.H*.23,c.W*.42,'ABL',d.anos,'pctAbl');_dmCronograma_(c.slide,c.W,c.H,c.W*.525,c.H*.23,c.W*.42,'RECEITA',d.anos,'pctReceita');}
function _dmCronograma_(s,W,H,x,y,w,titulo,anos,campo){const DS=CR_DESIGN_SYSTEM;_rrUmaLinha_(s,x,y,w,H*.05,titulo+' — 100%',{fs:W*.015,bold:true,cor:DS.colors.brandMed,align:'L',folga:0});const rh=Math.min(H*.075,H*.56/Math.max(1,anos.length));anos.forEach((a,i)=>{const yy=y+H*.065+i*rh,p=a[campo];_rrUmaLinha_(s,x,yy,w*.20,rh,a.ano,{fs:W*.010,bold:true,cor:DS.colors.textMain,align:'L'});_dmBar_(s,x+w*.2,yy+rh*.2,w*.38*p,rh*.55,DS.colors.brandLight);_rrUmaLinha_(s,x+w*.60,yy,w*.15,rh,(p*100).toFixed(1).replace('.',',')+'%',{fs:W*.010,bold:true,cor:DS.colors.textMain});_rrUmaLinha_(s,x+w*.74,yy,w*.26,rh,a.contratos.map(z=>z.nome).join(', '),{fs:W*.0078,cor:DS.colors.textBody,align:'L'});});}
